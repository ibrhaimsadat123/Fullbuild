// AI-assisted (Claude): Cloudflare Worker config for the TwinWorlds API.
// Secrets are NOT here. Set the Gemini key with:  npx wrangler secret put GEMINI_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twinworlds-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Where the deployed frontend serves data/processed (Cloudflare Pages URL + /data).
    "DATA_BASE_URL": "https://twinworlds.pages.dev/data",
    // Comma-separated list of sites allowed to call the API. Add the GoDaddy domain once it exists.
    "ALLOWED_ORIGINS": "https://twinworlds.pages.dev,http://localhost:5173",
    // Change here if Google retires this model name.
    "GEMINI_MODEL": "gemini-2.5-flash"
  }
}
