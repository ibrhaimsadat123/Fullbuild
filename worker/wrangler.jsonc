// AI-assisted (Claude): Cloudflare Worker config for the TwinWorlds API.
// Secrets are NOT here. Set the Gemini key with:  npx wrangler secret put GEMINI_API_KEY
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twinworlds-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Where the deployed frontend serves data/processed (Cloudflare Pages URL + /data).
    "DATA_BASE_URL": "https://twinworlds.pages.dev/data",
    "DOCS_URL": "https://twinworlds.us/api.html",
    // Comma-separated list of sites allowed to call the API (twinworlds.us = GoDaddy Registry domain).
    "ALLOWED_ORIGINS": "https://twinworlds.us,https://www.twinworlds.us,https://twinworlds.pages.dev,http://localhost:5173",
    // Tried in order; a retired (404) or busy (429/5xx) model falls through to the next.
    "GEMINI_MODEL": "gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest,gemini-flash-lite-latest"
  },
  // Hourly Cron Trigger: refreshes GET /v1/now (most Mars-like place on Earth right now).
  "triggers": { "crons": ["7 * * * *"] }
}
